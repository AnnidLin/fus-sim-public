{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fus-sim.evidence_registry.schema.v1",
  "title": "fus-sim Evidence Registry",
  "type": "object",
  "required": [
    "registry_version",
    "generated_at",
    "module",
    "scope",
    "inputs",
    "project_maturity_level",
    "global_claim_policy",
    "artifact_entries",
    "gate_states",
    "run_ledger_seed",
    "recommended_next_action",
    "not_executed"
  ],
  "properties": {
    "registry_version": {"type": "string"},
    "generated_at": {"type": "string"},
    "module": {"const": "evidence_registry"},
    "scope": {"type": "string"},
    "inputs": {
      "type": "object",
      "required": ["paths", "missing"],
      "properties": {
        "paths": {"type": "object"},
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "project_maturity_level": {
      "type": "object",
      "required": ["current", "rationale", "next_target"],
      "properties": {
        "current": {"type": "string"},
        "rationale": {"type": "string"},
        "next_target": {"type": "string"}
      }
    },
    "global_claim_policy": {
      "type": "object",
      "required": [
        "allowed_claims",
        "blocked_claims",
        "medical_or_safety_conclusion_allowed",
        "paper_grade_ready",
        "profile_promotion_allowed",
        "default_profile_change_allowed"
      ],
      "properties": {
        "allowed_claims": {"type": "array", "items": {"type": "string"}},
        "blocked_claims": {"type": "array", "items": {"type": "string"}},
        "medical_or_safety_conclusion_allowed": {"type": "boolean"},
        "paper_grade_ready": {"type": "boolean"},
        "profile_promotion_allowed": {"type": "boolean"},
        "default_profile_change_allowed": {"type": "boolean"}
      }
    },
    "artifact_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "title",
          "path",
          "artifact_type",
          "evidence_level",
          "maturity_level",
          "gate_status",
          "allowed_claims",
          "blocked_claims",
          "dependencies",
          "recommended_next_action",
          "sha256",
          "exists"
        ],
        "properties": {
          "artifact_id": {"type": "string"},
          "title": {"type": "string"},
          "path": {"type": "string"},
          "artifact_type": {"type": "string"},
          "evidence_level": {"type": "string"},
          "maturity_level": {"type": "string"},
          "gate_status": {"enum": ["pass", "warn", "block"]},
          "allowed_claims": {"type": "array", "items": {"type": "string"}},
          "blocked_claims": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "recommended_next_action": {"type": "string"},
          "sha256": {"type": ["string", "null"]},
          "exists": {"type": "boolean"}
        }
      }
    },
    "gate_states": {"type": "object"},
    "run_ledger_seed": {"type": "array"},
    "recommended_next_action": {"type": "string"},
    "not_executed": {"type": "array", "items": {"type": "string"}}
  }
}
